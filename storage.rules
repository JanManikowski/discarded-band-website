rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Band photos (About Us page) and show gallery photos.
    // Anyone can view them (the public site needs to render images).
    // Only YOUR Firebase Auth account can upload or delete.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "REPLACE_WITH_YOUR_UID"
                   // Only allow image files
                   && request.resource.contentType.matches('image/.*')
                   // Cap uploads at 10MB each
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
