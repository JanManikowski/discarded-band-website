+/* Styles for the footer booking line, contact email, shows toggle,
+   Spotify releases, Socials page and Press kit page. */
+
+:root {
+  --gold: #c4a96a;
+  --gold-soft: rgba(196, 169, 106, 0.15);
+  --ink: #0a060d;
+  --text: #e0e0e0;
+  --muted: #999;
+  --line: rgba(255, 255, 255, 0.12);
+}
+
+/* ── Navbar (desktop) ───────────────────────────────────── */
+/* Six links now. Keep every link on one line; centre them over the whole
+   bar when there's room, otherwise centre them in the space next to the
+   logo so they never run into it. */
+@media (min-width: 992px) {
+  .custom-navbar-links .custom-nav-link {
+    white-space: nowrap;
+  }
+}
+@media (min-width: 1400px) {
+  .custom-navbar-links {
+    width: max-content;
+  }
+}
+@media (min-width: 992px) and (max-width: 1399.98px) {
+  .custom-navbar-links {
+    position: static !important;
+    transform: none !important;
+    margin: 0 auto;
+  }
+  .custom-navbar-links .custom-nav-link {
+    font-size: 1.05rem;
+    margin-right: 1rem;
+  }
+}
+
+/* ── Footer ─────────────────────────────────────────────── */
+.footer-booking {
+  color: var(--text);
+  margin: 0 20px 16px;
+}
+.footer-booking a {
+  color: var(--gold);
+  font-weight: bold;
+  word-break: break-word;
+}
+.footer-links {
+  display: flex;
+  gap: 12px 20px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+@media (max-width: 575.98px) {
+  /* On phones the links wrap; hide the "|" so no line ends with one. */
+  .footer-sep {
+    display: none;
+  }
+  .footer-links {
+    gap: 10px 22px;
+  }
+}
+.footer-copyright {
+  color: var(--muted);
+  font-size: 0.85rem;
+  margin: 16px 0 0;
+}
+.footer-socials {
+  display: flex;
+  gap: 14px;
+  align-items: center;
+  justify-content: center;
+  flex-wrap: wrap;
+}
+.footer-socials a {
+  color: #fff;
+  display: inline-flex;
+  transition: color 0.2s ease, transform 0.2s ease;
+}
+.footer-socials a:hover,
+.footer-socials a:focus-visible {
+  color: var(--gold);
+  transform: translateY(-2px);
+}
+
+/* ── Email link with copy button ────────────────────────── */
+.email-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  justify-content: center;
+  max-width: 100%;
+}
+.email-link a {
+  color: var(--gold);
+  font-weight: bold;
+  text-decoration: none;
+  word-break: break-all;
+}
+.email-link a:hover {
+  text-decoration: underline;
+}
+.email-link-copy {
+  background: transparent;
+  border: 1px solid rgba(255, 255, 255, 0.4);
+  color: #fff;
+  border-radius: 4px;
+  width: 32px;
+  height: 32px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 0.85rem;
+  cursor: pointer;
+  transition: border-color 0.2s ease, color 0.2s ease;
+}
+.email-link-copy:hover,
+.email-link-copy:focus-visible {
+  border-color: var(--gold);
+  color: var(--gold);
+}
+
+/* ── Contact page ───────────────────────────────────────── */
+.contact-direct {
+  text-align: center;
+  max-width: 500px;
+  width: 100%;
+  margin: -16px auto 28px;
+}
+.contact-direct-label {
+  color: var(--text);
+  margin-bottom: 8px;
+}
+.contact-direct-email a {
+  font-size: 1.3rem;
+}
+.contact-direct-note {
+  color: var(--muted);
+  font-size: 0.9rem;
+  margin: 10px 0 0;
+}
+.contact-direct-note a {
+  color: var(--gold);
+}
+
+/* ── Shows page toggle ──────────────────────────────────── */
+.shows-toggle {
+  display: inline-flex;
+  border: 1px solid rgba(255, 255, 255, 0.6);
+  margin: -12px 0 6px;
+}
+.shows-toggle-btn {
+  background: transparent;
+  border: 0;
+  color: var(--text);
+  padding: 10px 24px;
+  text-transform: uppercase;
+  font-weight: bold;
+  letter-spacing: 1px;
+  font-size: 0.85rem;
+  cursor: pointer;
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+.shows-toggle-btn + .shows-toggle-btn {
+  border-left: 1px solid rgba(255, 255, 255, 0.6);
+}
+.shows-toggle-btn.active {
+  background: var(--gold);
+  color: var(--ink);
+}
+.shows-toggle-btn:not(.active):hover,
+.shows-toggle-btn:not(.active):focus-visible {
+  color: var(--gold);
+}
+.shows-toggle-count {
+  display: inline-block;
+  margin-left: 8px;
+  font-weight: normal;
+  opacity: 0.7;
+}
+.shows-note {
+  color: var(--muted);
+  margin: 18px 0 0;
+}
+.shows-empty {
+  color: var(--muted);
+  margin-top: 28px;
+}
+/* ── Spotify players (Home + Releases) ──────────────────── */
+.spotify-releases {
+  display: grid;
+  gap: 28px;
+  width: 100%;
+}
+.spotify-releases.is-pair {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+.spotify-release-label {
+  color: var(--gold);
+  text-transform: uppercase;
+  font-size: 1.1rem;
+  font-weight: bold;
+  letter-spacing: 2px;
+  margin: 0 0 12px;
+  text-align: left;
+}
+.spotify-release-frame {
+  background: var(--ink);
+  border-radius: 12px;
+  padding: 12px;
+  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
+}
+.spotify-release-frame iframe {
+  display: block;
+  width: 100%;
+  height: 352px;
+  border: 0;
+  border-radius: 10px;
+}
+.spotify-releases.is-single .spotify-release-frame iframe {
+  height: 560px;
+}
+@media (max-width: 991.98px) {
+  .spotify-releases.is-pair {
+    grid-template-columns: 1fr;
+  }
+}
+@media (max-width: 768px) {
+  .spotify-release-frame {
+    padding: 6px;
+  }
+  .spotify-releases.is-single .spotify-release-frame iframe {
+    height: 352px;
+  }
+}
+
+/* ── Socials page ───────────────────────────────────────── */
+.socials-page {
+  display: block !important; /* responsive.css turns .container-fluid into a row on phones */
+  background-color: var(--ink);
+  min-height: 100vh;
+  padding: 0 20px 80px;
+}
+.socials-intro {
+  color: var(--text);
+  text-align: center;
+  font-size: 1.15rem;
+  max-width: 640px;
+  margin: -16px auto 40px;
+}
+.socials-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 20px;
+  max-width: 1100px;
+  margin: 0 auto;
+}
+.socials-grid.is-odd > .social-card:first-child {
+  grid-column: 1 / -1;
+  min-height: 300px;
+}
+@media (max-width: 767.98px) {
+  .socials-grid {
+    grid-template-columns: 1fr;
+  }
+  .socials-grid.is-odd > .social-card:first-child {
+    min-height: 240px;
+  }
+}
+
+.social-card {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  align-items: flex-start;
+  gap: 4px;
+  min-height: 240px;
+  padding: 26px;
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  background:
+    radial-gradient(circle at 85% 15%, var(--brand-glow), transparent 60%),
+    linear-gradient(160deg, #1a1320 0%, #0a060d 70%);
+  color: #fff;
+  text-decoration: none;
+  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
+}
+.social-card:hover,
+.social-card:focus-visible {
+  color: #fff;
+  transform: translateY(-4px);
+  border-color: var(--brand);
+  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55);
+}
+.social-card-bg {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  z-index: -3;
+  transition: transform 0.6s ease;
+}
+.social-card:hover .social-card-bg {
+  transform: scale(1.05);
+}
+.social-card-shade {
+  position: absolute;
+  inset: 0;
+  z-index: -2;
+  background: linear-gradient(to top, rgba(10, 6, 13, 0.96) 0%, rgba(10, 6, 13, 0.7) 45%, rgba(10, 6, 13, 0.2) 100%);
+}
+.social-card:not(.has-image) .social-card-shade {
+  display: none;
+}
+.social-card-watermark {
+  position: absolute;
+  top: -36px;
+  right: -36px;
+  width: 230px;
+  height: 230px;
+  color: var(--brand);
+  opacity: 0.08;
+  transform: rotate(-12deg);
+  z-index: -1;
+  transition: transform 0.4s ease, opacity 0.4s ease;
+}
+.social-card:hover .social-card-watermark {
+  opacity: 0.14;
+  transform: rotate(-4deg) scale(1.06);
+}
+.social-card.has-image .social-card-watermark {
+  display: none;
+}
+.social-card-icon {
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1.5rem;
+  color: var(--brand);
+  background: var(--brand-soft);
+  border: 1px solid var(--brand);
+  margin-bottom: 12px;
+}
+.social-card-title {
+  font-size: 1.5rem;
+  font-weight: bold;
+  text-transform: uppercase;
+  letter-spacing: 2px;
+  line-height: 1.2;
+}
+.social-card-handle {
+  color: var(--gold);
+  font-weight: bold;
+  word-break: break-word;
+}
+.social-card-desc {
+  color: #cfcfcf;
+  font-size: 0.95rem;
+  max-width: 46ch;
+}
+.social-card-cta {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  margin-top: 14px;
+  padding-top: 12px;
+  border-top: 1px solid var(--line);
+  width: 100%;
+  color: var(--gold);
+  font-size: 0.85rem;
+  font-weight: bold;
+  text-transform: uppercase;
+  letter-spacing: 1.5px;
+}
+.social-card-cta svg {
+  transition: transform 0.25s ease;
+}
+.social-card:hover .social-card-cta svg {
+  transform: translateX(5px);
+}
+@media (prefers-reduced-motion: reduce) {
+  .social-card,
+  .social-card-bg,
+  .social-card-watermark,
+  .social-card-cta svg {
+    transition: none;
+  }
+}
+
+/* ── Press kit (EPK) page ───────────────────────────────── */
+.press-page {
+  background-color: var(--ink);
+  padding-top: 100px; /* fixed navbar */
+  padding-bottom: 80px;
+}
+.press-hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 460px;
+  height: min(76vh, 760px);
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  overflow: hidden;
+}
+.press-hero-img {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+  z-index: -2;
+}
+.press-hero-img.is-photo {
+  object-position: center 30%;
+}
+.press-hero-shade {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: linear-gradient(
+    to bottom,
+    rgba(10, 6, 13, 0.45) 0%,
+    rgba(10, 6, 13, 0.1) 35%,
+    rgba(10, 6, 13, 0.8) 78%,
+    #0a060d 100%
+  );
+}
+.press-hero-content {
+  text-align: center;
+  padding: 0 20px 36px;
+  max-width: 900px;
+}
+.press-kicker {
+  display: inline-block;
+  color: var(--gold);
+  text-transform: uppercase;
+  letter-spacing: 4px;
+  font-size: 0.85rem;
+  font-weight: bold;
+  border: 1px solid rgba(196, 169, 106, 0.6);
+  padding: 6px 14px;
+  margin-bottom: 18px;
+  background: rgba(10, 6, 13, 0.4);
+}
+.press-hero-title {
+  margin: 0;
+}
+.press-hero-title img {
+  width: min(560px, 80vw);
+  height: auto;
+  filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.8));
+}
+.press-genre {
+  color: var(--text);
+  font-size: 1.3rem;
+  letter-spacing: 1px;
+  margin: 14px 0 0;
+  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
+}
+
+.press-section {
+  max-width: 1000px;
+  margin: 0 auto;
+  padding: 64px 20px 0;
+}
+.press-heading {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  color: var(--gold);
+  text-transform: uppercase;
+  letter-spacing: 3px;
+  font-size: 1.1rem;
+  font-weight: bold;
+  margin: 0 0 28px;
+}
+.press-heading::before,
+.press-heading::after {
+  content: "";
+  flex: 1;
+  height: 1px;
+  background: var(--line);
+}
+.press-manifesto {
+  max-width: 760px;
+  margin: 0 auto;
+  font-size: 1.2rem;
+  line-height: 1.8;
+  color: var(--text);
+  text-align: center;
+}
+
+.press-quotes {
+  display: grid;
+  gap: 20px;
+}
+.press-quotes.count-1 {
+  max-width: 760px;
+  margin: 0 auto;
+}
+.press-quotes.count-2 {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+.press-quotes.count-3 {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+.press-quote {
+  margin: 0;
+  padding: 28px 26px 24px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.03);
+  display: flex;
+  flex-direction: column;
+}
+.press-quote-mark {
+  color: var(--gold);
+  font-size: 1.6rem;
+  margin-bottom: 14px;
+}
+.press-quote blockquote {
+  margin: 0 0 18px;
+  font-size: 1.1rem;
+  font-style: italic;
+  line-height: 1.6;
+  color: #f2f2f2;
+  flex: 1;
+}
+.press-quote figcaption {
+  color: var(--gold);
+  text-transform: uppercase;
+  letter-spacing: 1.5px;
+  font-size: 0.85rem;
+  font-weight: bold;
+}
+.press-quote figcaption::before {
+  content: "— ";
+}
+.press-quote figcaption a {
+  color: inherit;
+}
+
+.press-video {
+  position: relative;
+  aspect-ratio: 16 / 9;
+  width: 100%;
+  border-radius: 12px;
+  overflow: hidden;
+  background: #000;
+  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
+}
+.press-video iframe {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
+
+.press-downloads {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+.press-card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 6px;
+  padding: 26px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.03);
+  color: #fff;
+  text-decoration: none;
+}
+.press-card.is-link {
+  transition: border-color 0.2s ease, transform 0.2s ease;
+}
+.press-card.is-link:hover,
+.press-card.is-link:focus-visible {
+  color: #fff;
+  border-color: var(--gold);
+  transform: translateY(-3px);
+}
+.press-card h3 {
+  font-size: 1.05rem;
+  font-weight: bold;
+  text-transform: uppercase;
+  letter-spacing: 2px;
+  margin: 6px 0 0;
+}
+.press-card p {
+  color: #bdbdbd;
+  margin: 0 0 8px;
+}
+/* Booking: one wide card with the address big and easy to copy */
+.press-card.is-booking {
+  flex-direction: row;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 16px 28px;
+  border-color: rgba(196, 169, 106, 0.45);
+  background: linear-gradient(120deg, rgba(196, 169, 106, 0.08), rgba(255, 255, 255, 0.02) 60%);
+}
+.press-booking-text {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 6px;
+}
+.press-booking-text p {
+  margin: 0;
+}
+.press-booking-email {
+  justify-content: flex-start;
+  flex-wrap: nowrap;
+}
+.press-booking-email a {
+  font-size: 1.3rem;
+  word-break: normal;
+  overflow-wrap: anywhere;
+}
+.press-card-icon {
+  color: var(--gold);
+  font-size: 1.6rem;
+}
+.press-card-meta {
+  color: var(--muted);
+}
+.press-card-cta {
+  margin-top: auto;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--gold);
+  font-weight: bold;
+  text-transform: uppercase;
+  letter-spacing: 1.5px;
+  font-size: 0.85rem;
+}
+.press-socials {
+  display: flex;
+  justify-content: center;
+  flex-wrap: wrap;
+  gap: 18px;
+  margin-top: 36px;
+  font-size: 1.5rem;
+}
+.press-socials a {
+  color: #fff;
+  transition: color 0.2s ease;
+}
+.press-socials a:hover,
+.press-socials a:focus-visible {
+  color: var(--gold);
+}
+
+@media (max-width: 991.98px) {
+  .press-quotes.count-3 {
+    grid-template-columns: 1fr;
+  }
+}
+@media (max-width: 767.98px) {
+  .press-page {
+    padding-top: 90px;
+  }
+  .press-hero {
+    height: 62vh;
+    min-height: 380px;
+  }
+  .press-genre {
+    font-size: 1.1rem;
+  }
+  .press-quotes.count-2 {
+    grid-template-columns: 1fr;
+  }
+  .press-section {
+    padding-top: 48px;
+  }
+  .press-manifesto {
+    font-size: 1.05rem;
+    text-align: left;
+  }
+  .press-card.is-booking {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+  .press-booking-email {
+    flex-wrap: wrap;
+  }
+  .press-booking-email a {
+    font-size: 0.95rem;
+  }
+}
+
+.show-card-played {
+  color: var(--muted);
+  border: 1px solid #444;
+  padding: 6px 14px;
+  font-size: 0.75rem;
+  text-transform: uppercase;
+  letter-spacing: 1px;
+  white-space: nowrap;
+}
