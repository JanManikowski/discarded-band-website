+              style={adminSaveButtonStyle(saving || loadFailed)}
+            >
+              {saving ? "Saving..." : "Save Press Kit"}
+            </button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default PressEditor;
