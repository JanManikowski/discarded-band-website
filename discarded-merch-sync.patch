diff --git a/scripts/merch-sync/parseMerch.js b/scripts/merch-sync/parseMerch.js
new file mode 100644
index 0000000..aecf57b
--- /dev/null
+++ b/scripts/merch-sync/parseMerch.js
@@ -0,0 +1,123 @@
+"use strict";
+
+const cheerio = require("cheerio");
+
+// Bandcamp serves every image in several sizes, chosen by the number before
+// ".jpg" (from Bandcamp's own image_formats list):
+//   36 = 400x300 crop  (what the merch grid shows)
+//   10 = up to 1200px, not cropped  (used for the website cards)
+const GRID_IMAGE_FORMAT = 36;
+const LARGE_IMAGE_FORMAT = 10;
+
+const norm = (s) => (s || "").replace(/\s+/g, " ").trim();
+
+const isBandcampUrl = (url) =>
+  url.protocol === "https:" &&
+  (url.hostname === "bandcamp.com" || url.hostname.endsWith(".bandcamp.com"));
+
+const isBandcampImage = (value) => {
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && (url.hostname === "bcbits.com" || url.hostname.endsWith(".bcbits.com"));
+  } catch {
+    return false;
+  }
+};
+
+/** Swaps the size number at the end of a Bandcamp image URL: ..._36.jpg → ..._10.jpg */
+const imageWithFormat = (url, formatId) =>
+  url.replace(/_\d{1,3}\.(jpg|jpeg|png|gif)$/i, `_${formatId}.jpg`);
+
+/**
+ * The number in a displayed price: "€20" → 20, "€12.50" → 12.5,
+ * "€1.234,50" → 1234.5, "$1,234" → 1234. Returns null when there's none.
+ */
+const parseAmount = (priceText) => {
+  const match = (priceText || "").match(/\d[\d.,\s]*/);
+  if (!match) return null;
+  let s = match[0].replace(/\s/g, "").replace(/[.,]$/, "");
+  const lastDot = s.lastIndexOf(".");
+  const lastComma = s.lastIndexOf(",");
+
+  if (lastDot !== -1 && lastComma !== -1) {
+    // Both used: the last one is the decimal separator.
+    s = lastDot > lastComma ? s.replace(/,/g, "") : s.replace(/\./g, "").replace(",", ".");
+  } else if (lastComma !== -1) {
+    s = /,\d{1,2}$/.test(s) ? s.replace(",", ".") : s.replace(/,/g, "");
+  } else if (/\.\d{3}$/.test(s)) {
+    s = s.replace(/\./g, ""); // "1.234" = thousands
+  }
+
+  const n = Number.parseFloat(s);
+  return Number.isFinite(n) ? n : null;
+};
+
+/**
+ * Reads the merch grid of a Bandcamp merch page (e.g.
+ * https://discardedband.bandcamp.com/merch) and returns one object per item,
+ * in the order Bandcamp shows them:
+ *
+ *   { id, title, type, url, priceText, currency, amount, soldOut, thumbUrl, imageUrl }
+ *
+ * Only links to *.bandcamp.com and images from *.bcbits.com are kept, so the
+ * website never ends up linking somewhere unexpected.
+ */
+const parseMerchPage = (html, pageUrl) => {
+  const $ = cheerio.load(html);
+  const base = new URL(pageUrl);
+
+  let rows = $("#merch-grid > li");
+  if (rows.length === 0) rows = $("li.merch-grid-item");
+
+  const items = [];
+  const seen = new Set();
+
+  rows.each((_, el) => {
+    const li = $(el);
+    const link = li.find("a[href]").first();
+    const href = link.attr("href");
+    if (!href) return;
+
+    let url;
+    try {
+      url = new URL(href, base);
+    } catch {
+      return;
+    }
+    if (!isBandcampUrl(url) || !/^\/(merch|album|track)\//.test(url.pathname)) return;
+    url.search = "";
+    url.hash = "";
+
+    const title = norm(li.find(".title").first().text()) || norm(link.text());
+    if (!title) return;
+
+    const id = norm(li.attr("data-item-id")) || `${url.pathname}#${title}`;
+    if (seen.has(id)) return;
+    seen.add(id);
+
+    const priceBlock = li.find("p.price").first();
+    const soldOut = li.find(".sold-out").length > 0 || /\bsold out\b/i.test(norm(priceBlock.text()));
+    const priceText = soldOut ? "" : norm(li.find("span.price").first().text());
+
+    const img = li.find("img").first();
+    const rawImage = (img.attr("data-original") || img.attr("src") || "").split("?")[0];
+    const thumbUrl = isBandcampImage(rawImage) ? rawImage : null;
+
+    items.push({
+      id,
+      title,
+      type: norm(li.find(".merchtype").first().text()),
+      url: url.toString(),
+      priceText,
+      currency: soldOut ? "" : norm(li.find("span.currency").first().text()),
+      amount: soldOut ? null : parseAmount(priceText),
+      soldOut,
+      thumbUrl,
+      imageUrl: thumbUrl ? imageWithFormat(thumbUrl, LARGE_IMAGE_FORMAT) : null,
+    });
+  });
+
+  return items;
+};
+
+module.exports = { parseMerchPage, parseAmount, imageWithFormat, GRID_IMAGE_FORMAT, LARGE_IMAGE_FORMAT };
diff --git a/scripts/merch-sync/sync.js b/scripts/merch-sync/sync.js
new file mode 100644
index 0000000..43b4ceb
--- /dev/null
+++ b/scripts/merch-sync/sync.js
@@ -0,0 +1,139 @@
+"use strict";
+
+/**
+ * Copies the band's merch from Bandcamp into Firestore (site_content/merch),
+ * where the website's Merch page reads it. Runs once a day from GitHub
+ * Actions (.github/workflows/sync-merch.yml), or by hand:
+ *
+ *   node sync.js --dry-run     show what would be saved, write nothing
+ *   node sync.js               needs FIREBASE_SERVICE_ACCOUNT (the key JSON)
+ *
+ * If Bandcamp can't be read or the page layout changed, nothing is
+ * overwritten: the site keeps the last good list, the error is saved next to
+ * it so the admin page can show it, and the run fails (GitHub emails you).
+ */
+
+const { parseMerchPage } = require("./parseMerch");
+
+const DEFAULT_MERCH_URL = "https://discardedband.bandcamp.com/merch";
+const USER_AGENT = "DiscardedWebsiteMerchSync/1.0 (+https://discardedband.com)";
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+async function fetchPage(url, fetchImpl, attempts = 3) {
+  let lastError;
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      const res = await fetchImpl(url, {
+        headers: { "User-Agent": USER_AGENT, Accept: "text/html" },
+        signal: AbortSignal.timeout(20000),
+      });
+      if (!res.ok) throw new Error(`Bandcamp answered ${res.status} ${res.statusText || ""}`.trim());
+      return await res.text();
+    } catch (err) {
+      lastError = err;
+      if (attempt < attempts) await sleep(2000 * attempt);
+    }
+  }
+  throw lastError;
+}
+
+// The large image size has worked for every merch photo so far; if one
+// doesn't exist, use the grid thumbnail instead of showing a broken image.
+async function checkImages(items, fetchImpl) {
+  await Promise.all(
+    items.map(async (item) => {
+      if (!item.imageUrl || item.imageUrl === item.thumbUrl) return;
+      try {
+        const res = await fetchImpl(item.imageUrl, {
+          method: "HEAD",
+          headers: { "User-Agent": USER_AGENT },
+          signal: AbortSignal.timeout(10000),
+        });
+        if (!res.ok) item.imageUrl = item.thumbUrl;
+      } catch {
+        item.imageUrl = item.thumbUrl;
+      }
+    })
+  );
+}
+
+/**
+ * One sync run. Everything it needs is passed in, so tests can use fakes.
+ * Returns the items found; throws (after recording the error) on failure.
+ */
+async function runSync({
+  merchUrl = DEFAULT_MERCH_URL,
+  fetchImpl = fetch,
+  docRef = null,
+  serverTimestamp = () => new Date(),
+  log = console.log,
+  attempts = 3,
+}) {
+  try {
+    const html = await fetchPage(merchUrl, fetchImpl, attempts);
+    const items = parseMerchPage(html, merchUrl);
+    if (items.length === 0) {
+      throw new Error("Found no merch items on the Bandcamp page; Bandcamp may have changed its layout.");
+    }
+    await checkImages(items, fetchImpl);
+
+    log(`Found ${items.length} merch items on ${merchUrl}:`);
+    items.forEach((item) => log(`  - ${item.title} | ${item.soldOut ? "SOLD OUT" : item.priceText || "no price"}`));
+
+    if (docRef) {
+      await docRef.set(
+        { items, sourceUrl: merchUrl, syncedAt: serverTimestamp(), lastCheckAt: serverTimestamp(), lastError: null },
+        { merge: true }
+      );
+      log("Saved to Firestore: site_content/merch");
+    } else {
+      log("Dry run: nothing saved.");
+    }
+    return items;
+  } catch (err) {
+    if (docRef) {
+      // Only the error and time are written; the saved items stay as they were.
+      await docRef
+        .set({ lastCheckAt: serverTimestamp(), lastError: err.message }, { merge: true })
+        .catch((saveErr) => log(`Also couldn't save the error to Firestore: ${saveErr.message}`));
+    }
+    throw err;
+  }
+}
+
+function connectFirestore() {
+  const raw = process.env.FIREBASE_SERVICE_ACCOUNT;
+  if (!raw) {
+    throw new Error("FIREBASE_SERVICE_ACCOUNT is not set. Add the Firebase key as a GitHub Actions secret with that name.");
+  }
+  let credentials;
+  try {
+    credentials = JSON.parse(raw);
+  } catch {
+    throw new Error("FIREBASE_SERVICE_ACCOUNT isn't valid JSON. Paste the whole contents of the downloaded key file into the secret.");
+  }
+  const { initializeApp, cert } = require("firebase-admin/app");
+  const { getFirestore, FieldValue } = require("firebase-admin/firestore");
+  initializeApp({ credential: cert(credentials) });
+  return {
+    docRef: getFirestore().doc("site_content/merch"),
+    serverTimestamp: () => FieldValue.serverTimestamp(),
+  };
+}
+
+async function main() {
+  const dryRun = process.argv.includes("--dry-run");
+  const merchUrl = process.env.MERCH_URL || DEFAULT_MERCH_URL;
+  const firestore = dryRun ? {} : connectFirestore();
+  await runSync({ merchUrl, ...firestore });
+}
+
+if (require.main === module) {
+  main().catch((err) => {
+    console.error(`Merch sync failed: ${err.message}`);
+    process.exitCode = 1;
+  });
+}
+
+module.exports = { runSync, fetchPage, checkImages, DEFAULT_MERCH_URL };
diff --git a/scripts/merch-sync/test/parseMerch.test.js b/scripts/merch-sync/test/parseMerch.test.js
